# Create this key in Google AI Studio. Never commit a real key.
GEMINI_API_KEY=replace-with-your-private-key

# Optional. The application defaults to this stable, free-tier-capable model.
GEMINI_MODEL=gemini-3.5-flash

# Part 4 semantic retrieval settings. Changing either requires re-embedding data.
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSION=768
